  {
   "seq": "7",
   "text": "梅の老にほふ春へは難波津やふるさにかへす浦風そふく",
   "kana": "",
   "speaker": "尭孝",
   "page": 4,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "津梅",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "かすひ夜の月のかはらも梅の花うつるにほひやさたかなるらん",
   "kana": "",
   "speaker": "雅永",
   "page": 4,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜梅",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "青柳のおきふしなひく水かけはきしうつなみもみとりなりけり",
   "kana": "",
   "speaker": "常永",
   "page": 4,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岸榊",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "うす霞それとはかせにふりいてゝ風はをもせぬはるをめのそら",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雨",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "いまもなをみかくと見へて玉の床ひかりそへたるはるはるの月",
   "kana": "",
   "speaker": "満久",
   "page": 4,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春月",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "霞たつ山のはとをき月かけののこるもうすきあけほのゝ空",
   "kana": "",
   "speaker": "有光",
   "page": 4,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春曙",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "たちまよふいくへの雲のかよひちにつはこそゆまて雁帰らん",
   "kana": "",
   "speaker": "正殿",
   "page": 4,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰丁",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "一ゆくすゑの春を契りてうへそむる花には風もをかはこらなん",
   "kana": "",
   "speaker": "特之",
   "page": 4,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "栽花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "一あかすみか木其衛岩色はしろみねの雲さへをなし芒の夕はえ",
   "kana": "",
   "speaker": "公種",
   "page": 5,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "翫花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "こころあれはたをらぬ尤の梢をも風はのことてなとさそふはん",
   "kana": "",
   "speaker": "雅清",
   "page": 5,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "惜花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "のとかなるよとの川なみ春見へてみつのみまきに駒そいはゆる",
   "kana": "",
   "speaker": "満祐",
   "page": 5,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春駒",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "吉野川春の名残の花の花の花の花のほのきしの心ふき",
   "kana": "",
   "speaker": "持頼",
   "page": 5,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "款冬",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "そめてけり水のこゝろも春の色もこきむらさきの池の藤波",
   "kana": "",
   "speaker": "尹賢",
   "page": 5,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紫藤",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "まころまてたし見あかさはいたはらにねぬ夜のゆめて春や過なん",
   "kana": "",
   "speaker": "基親",
   "page": 5,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "春ふかく見へし青葉の梢よりをなし色そふ夏は来にけり",
   "kana": "",
   "speaker": "元昌",
   "page": 5,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "首夏",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "たちかふるほともしはしと袖ふれて花の香しとふなつころも哉",
   "kana": "",
   "speaker": "直親",
   "page": 5,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "更衣",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "山さとにちりしてくらの雪はまた夏にのこりてさける神尤",
   "kana": "",
   "speaker": "梵燈",
   "page": 5,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神花",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "一むら雨の雲にをくるゝほときす木にのこすゑややとり成らん",
   "kana": "",
   "speaker": "道歓",
   "page": 6,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "一宮の軒のたち尤匂ひきて風ゑたりも今そもくし羅類に",
   "kana": "",
   "speaker": "元保",
   "page": 6,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "砌橘",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "わきもこかすそわの田井にとるなへのしつくも露も袖にかけつゝ",
   "kana": "",
   "speaker": "益之",
   "page": 6,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早苗",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "かくれぬのみくこにあまるあやめ草あやめをわきてもふや引まし",
   "kana": "",
   "speaker": "重阿",
   "page": 6,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "銀菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "一和かの浦になみやこちそふ藪嶋のなかのみなとの五月雨のころ",
   "kana": "",
   "speaker": "常松",
   "page": 6,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "梅雨",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "しくるつきころはいまより土をそれときたはぬ雲の夕こちの空",
   "kana": "",
   "speaker": "元久",
   "page": 6,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "松山のまつはときはの色なるをなつき舟をりとしける下くさ",
   "kana": "",
   "speaker": "実城",
   "page": 6,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏草",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "いつるまも浪間にあけてあみの浦やめにもたまらぬ短夜の月",
   "kana": "",
   "speaker": "寶密",
   "page": 6,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "おひきよる露の小薄みこれても色うつもれぬとこなつの花",
   "kana": "",
   "speaker": "為并",
   "page": 6,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "瞿夏",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "夏としもしらさぬものを氷にてわけぬひむろのあたりはかりは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "氷室",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "木のまもる夕日のかけもうすころも袖にすゝしき松のしこれ",
   "kana": "",
   "speaker": "之重",
   "page": 7,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "納涼",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "遊ふかつらあさのゝそにひきそへて御祓もたへぬ玉のをにそん",
   "kana": "",
   "speaker": "宋雅",
   "page": 7,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏抜",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "露堂にも無すはぬ袖の朝あけに風こそ秋をまつしみ歩けれ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早秋",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "かちの葉のたむけもうくる中に猶うれしき君か水草の跡",
   "kana": "",
   "speaker": "常建",
   "page": 7,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "秋の田のかにむにひすに露のまもかけは天むかかひの稲つま",
   "kana": "",
   "speaker": "尹賢",
   "page": 7,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "稲妻",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "風のをその松にうつれるたえまとやまらきの萩にむすふ夕露",
   "kana": "",
   "speaker": "元継",
   "page": 7,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "籬荻",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "名にしをふ類揃も見へす尤吹ぬわかむらさきの野への秋はき",
   "kana": "",
   "speaker": "聖信",
   "page": 7,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野荻",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "わけゆけはかね〳〵に花も我神もひとつにつゝく野へのあれ風",
   "kana": "",
   "speaker": "元衡",
   "page": 7,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "路薄",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "これもまた玉の床とや松やまのした露みかく有明の月",
   "kana": "",
   "speaker": "性光",
   "page": 7,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁露",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "中かさにしはしときこす朝皃のぬれて色こき花のし羅露",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "隣模",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "まくす平露ふきみわす秋風に下なる草もうらみやせぬ",
   "kana": "",
   "speaker": "宋雅",
   "page": 8,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "葛風",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "夕暮の色にやみねを隔つらんうはの空なるさを鹿の声",
   "kana": "",
   "speaker": "道釈",
   "page": 8,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕鹿",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "秋きりのこつにつれてや越ぬらんみねよりつかくはつ雁のこゑ",
   "kana": "",
   "speaker": "有光",
   "page": 8,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初雁",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "露やそふ夜こむやまさるきり〳〵すなくねあまたの庭の草むら",
   "kana": "",
   "speaker": "満久",
   "page": 8,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤虫",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "にほ宿海や夕きりうつむからさきの松は一木のをもかけもなし",
   "kana": "",
   "speaker": "正徹",
   "page": 8,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "崎霧",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "一秋風の雲吹はらふあとよりてひかりをそふるやまのはのつき",
   "kana": "",
   "speaker": "持之",
   "page": 8,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "嶺月",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "ひらのやまたかねの雲のなみかけて月に吹しく志賀の浦風",
   "kana": "",
   "speaker": "基視",
   "page": 8,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朔月",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "よな〳〵は須磨の関守われとこそゆめちゆるさて月を見るゝめ",
   "kana": "",
   "speaker": "尭孝",
   "page": 8,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関月",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "さかへやく君かよはひはなか浜の菊も不もせの色にたへつら",
   "kana": "",
   "speaker": "公種",
   "page": 8,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浜菊",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "あさちふのをのゝしの原秋ふけてよさむのやとゝころにうつあり",
   "kana": "",
   "speaker": "持頼",
   "page": 8,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "いくしほそ露も時雨も立田ひめこゝろのまゝにそむかもみちは",
   "kana": "",
   "speaker": "雅永",
   "page": 9,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "黄葉",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "いのりこし御代長月の秋の暮いく千とせまて君かしらまし",
   "kana": "",
   "speaker": "妙文",
   "page": 9,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮秋",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "霜となる夜のまの露の菊の葉にけさよりさやく冬は来にけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬益之",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "染かねてすくる時雨の露をこにはらはものこせ松の夕風",
   "kana": "",
   "speaker": "兼宜",
   "page": 9,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "時雨",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "をそふかそさゝし落葉のひまことに月こそ残れ木からしの風",
   "kana": "",
   "speaker": "基之",
   "page": 9,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薄葉",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "も草もかれふの野への露の下に菊のみ尤の名はのこりつゝ",
   "kana": "",
   "speaker": "為盛",
   "page": 9,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "枯野",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "沢田川こほりのうへの芦の葉もたえぬ霜夜に風さやくなり",
   "kana": "",
   "speaker": "持え",
   "page": 9,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒蘆",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "たちよれはたもともさむき山の井のみなそこ清く氷ゐにけり",
   "kana": "",
   "speaker": "有高",
   "page": 9,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "井水",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "夜やさむきみきはの浪にけりはへて千鳥しはなくあやの川かせ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "千馬",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "一秋こにもころもにかねいとゝしくたへぬ霜夜の空に鳴なり",
   "kana": "",
   "speaker": "雅清",
   "page": 10,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残雁",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "ひこするに月にやむかふあしろもり氷魚のよかへも浪の氷に",
   "kana": "",
   "speaker": "元久",
   "page": 10,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "納代",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "りたの原八十嶋かけてこほるとは浪より上の月やみゆらん",
   "kana": "",
   "speaker": "道歓",
   "page": 10,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "豊月",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "雲井よりふりしく雪の白妙に名をはうつまぬむらされの庭",
   "kana": "",
   "speaker": "常永",
   "page": 10,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭雪",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "たちのほかをふりまかはす見へにけり雪のうちなるをのゝ炭竈",
   "kana": "",
   "speaker": "之重",
   "page": 10,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "炭竈",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "やまさとは雪のしこをれはりそへてほきこしくふるうつみ火の本",
   "kana": "",
   "speaker": "信承",
   "page": 10,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "埋火",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "となへつる御名こそ三世にかはれともこゝろひもつはへたてなき哉",
   "kana": "",
   "speaker": "常松",
   "page": 10,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "仏名",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "りこの原をまりありはやゆく手にかけても春をまつか浦浪",
   "kana": "",
   "speaker": "干賢",
   "page": 10,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "みそめしは君のむかしも柏木も是よりやをなし思ひなりけん",
   "kana": "",
   "speaker": "実密",
   "page": 10,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "恋十五首初恋初恋宝密"
  },
  {
   "seq": "72",
   "text": "袖にせくなみこは色にいてすとも物をもふ身と人やとかめん",
   "kana": "",
   "speaker": "持元",
   "page": 10,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忍恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "しくれにもつきなきものと松風をきくよりやかてぬるゝ袖かな",
   "kana": "",
   "speaker": "梵燈",
   "page": 11,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "ことの葉もかよはぬ中なりそめのみるもそせめて契りなりける",
   "kana": "",
   "speaker": "元久",
   "page": 11,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "見恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "我のみやもすの草くきこつねみん人はゆるせぬしまへなりとも",
   "kana": "",
   "speaker": "為盛",
   "page": 11,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "逢まてとかけしみそきのかひなくはなをやうき身をからみみてまし",
   "kana": "",
   "speaker": "持之",
   "page": 11,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祈恋",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "浪こわぬ中をもまわる神ならはこの松やまをかけて契らん",
   "kana": "",
   "speaker": "親清",
   "page": 11,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "契恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "ちきりなきほとをはやしてかく過しきてたのむるをふそくらしわひぬる",
   "kana": "",
   "speaker": "兼宣",
   "page": 11,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "とにかくになにとおもひをすかはしやふしてあふ夜もなけくわかれに",
   "kana": "",
   "speaker": "性光",
   "page": 11,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "今のみかくあけぬにいそくわかれ土は人のまつよや思ひ出らん",
   "kana": "",
   "speaker": "直親",
   "page": 11,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "別応",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "こゝろにも袖にもつゝく涙川なにゝもれけるうき名なるらん",
   "kana": "",
   "speaker": "重阿",
   "page": 11,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "顕応",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "かきたへていかゝ恨みむわくるはにさふせへかゝる袖のなみたを",
   "kana": "",
   "speaker": "満祐",
   "page": 11,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "稀恋",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "にゐまくうまこもかはさてそのまゝに月日も葵もつもりこそゆけ",
   "kana": "",
   "speaker": "基之",
   "page": 12,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶恋",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "夕暮は雲のころものからみへてなをうきまよふ我こゝろかろかな",
   "kana": "",
   "speaker": "持頼",
   "page": 12,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "わするなといひしむかしのなかりせはふりぬる中に何をかこたん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旧恋",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "山かけのかきふししけはさゝの席に一夜もいかてあよしそめけん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家満祐",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "もるほとはかりなる庵もかすそひて田のもにきかふさとの一むら",
   "kana": "",
   "speaker": "宋雅",
   "page": 12,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田里",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "いまかゝる身のなきことを松山に住せぬとはなけきはてをん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "閑居",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "をくれしとしはふりかれに身をわけは我も幾夜のこひねしてまし",
   "kana": "",
   "speaker": "基親",
   "page": 12,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "離別",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "あさゆふに野山の霞をりくるより同すひきもなき旅衣も武",
   "kana": "",
   "speaker": "盛貢",
   "page": 12,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "羇旅",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "西の海や神の守りのひろけれは舟路にさはるなみ風もなし",
   "kana": "",
   "speaker": "満久",
   "page": 12,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海路",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "折しけるふもと先まし葉しはしたにねられぬ袖もかよふ山かあ",
   "kana": "",
   "speaker": "元高",
   "page": 13,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野宿",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "いたつらにその名はかりや古里のひかしにかへる志賀のさゝなみ",
   "kana": "",
   "speaker": "通盛",
   "page": 13,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "故郷",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "舟かけて話しつなかる夕なきに月のてしほやまつかから人",
   "kana": "",
   "speaker": "常永",
   "page": 13,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "眺望",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "なにことにおしむとはなき身なれともいまをらにもやすてはぬ説",
   "kana": "",
   "speaker": "元昌",
   "page": 13,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "松やまの露にも其趣き濃解しらすみぬ世をしふはよりに",
   "kana": "",
   "speaker": "有光",
   "page": 13,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "懐旧",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "とわし火のきえぬひかりや夜もすからひとりおきゐる家友と成らん",
   "kana": "",
   "speaker": "元資",
   "page": 13,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜燈",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "水茎のあとのめくみをまつ山に千代ふる寺やなをさかへまし",
   "kana": "",
   "speaker": "公種し",
   "page": 13,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旧寺",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "玉床の隔てもちかきみつかきにこえてやかよふみねのまつかせ",
   "kana": "",
   "speaker": "為井",
   "page": 13,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "瑞籬",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "君もけに神となりてそかくそかりすゑの代かけてなを聞らん",
   "kana": "",
   "speaker": "道歓",
   "page": 13,
   "pid": "nao-733860",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祝言",
   "kotobagaki": ""
  }
 ],
